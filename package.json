{
  "name": "fic-bible",
  "productName": "Fic Bible",
  "version": "0.0.1",
  "description": "Track the structure of fanfiction: works, chapters, scenes, beats.",
  "private": true,
  "main": "out/main/index.js",
  "config": {
    "node_gyp_force_build": "1"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "test": "node scripts/run-as-node.mjs --test \"test/**/*.test.mjs\"",
    "migrate": "node scripts/run-as-node.mjs scripts/migrate.mjs",
    "seed": "node scripts/run-as-node.mjs scripts/seed/seed.mjs",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "13.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.8"
  }
}
